{
  "name": "notion-ledger",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "volta": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:dev": "PUBLIC_APP_MODE=dev astro build",
    "build:prod": "PUBLIC_APP_MODE=prod astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run test:all",
    "test:codex": "env -u npm_config_prefix -u NPM_CONFIG_PREFIX -u PREFIX bash ./scripts/run-with-project-node.sh npm run test:all",
    "test:all": "npm run test:api",
    "generate:openapi": "node ./scripts/generate-openapi.mjs",
    "sync:openapi": "node ./scripts/sync-openapi.mjs",
    "verify:openapi": "node ./scripts/verify-openapi.mjs",
    "test:api": "node --test --experimental-strip-types ./tests/api/**/*.test.ts"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.2.2",
    "svelte": "^5.56.10"
  }
}
