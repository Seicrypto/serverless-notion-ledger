---
import SidebarNav from '../components/SidebarNav.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';
import '../styles/theme.css';
import '../styles/components.css';
import type { LangKey } from '../libs/i18n/context/langKeys';

interface Props {
	title?: string;
	description?: string;
	productName?: string;
	lang?: LangKey;
	currentPath?: string;
	labels?: {
		switchLanguage: string;
		changeTheme: string;
		login: string;
		home: string;
		openNavigation: string;
		closeNavigation: string;
		navigation: string;
		navOverview: string;
		navEvents: string;
		navPayouts: string;
		navDashboard: string;
		userStatus: string;
		guest: string;
		themeLight: string;
		themeDark: string;
		themeSystem: string;
	};
}

const {
	title = 'Raid Ledger',
	description = 'Lightweight event forms and payout tracking for guild leaders.',
	productName = 'Raid Ledger',
	lang = 'zh-tw',
	currentPath = '/zh-tw/',
	labels = {
		switchLanguage: 'Switch language',
		changeTheme: 'Change color theme',
		login: 'Login',
		home: 'Home',
		openNavigation: 'Open navigation',
		closeNavigation: 'Close navigation',
		navigation: 'Navigation',
		navOverview: 'Overview',
		navEvents: 'Event forms',
		navPayouts: 'Payouts',
		navDashboard: 'Dashboard',
		userStatus: 'User status',
		guest: 'Guest',
		themeLight: 'Light',
		themeDark: 'Dark',
		themeSystem: 'System',
	},
} = Astro.props;

const navItems = [
	{ label: labels.navOverview, href: `/${lang}/` },
	{ label: labels.navEvents, href: `/${lang}/#preview` },
	{ label: labels.navPayouts, href: `/${lang}/#preview` },
	{ label: labels.navDashboard, href: `/${lang}/#naming` },
];
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<slot name="head" />
		<script is:inline>
			(() => {
				const stored = window.localStorage.getItem('theme-mode');
				const themeMode =
					stored === 'light' || stored === 'dark' || stored === 'system' ? stored : 'system';
				const resolvedTheme =
					themeMode === 'system'
						? window.matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light'
						: themeMode;

				document.documentElement.dataset.themeMode = themeMode;
				document.documentElement.dataset.theme = resolvedTheme;
			})();
		</script>
	</head>
	<body>
		<div class="page-shell">
			<SidebarNav
				title={labels.navigation}
				items={navItems}
				closeLabel={labels.closeNavigation}
				statusLabel={labels.userStatus}
				statusValue={labels.guest}
			/>
			<header class="site-header">
				<div class="header-side">
					<button
						class="menu-toggle"
						type="button"
						aria-label={labels.openNavigation}
						aria-expanded="false"
						aria-controls="app-sidebar"
						data-sidebar-trigger
					>
						<span></span>
						<span></span>
						<span></span>
					</button>
				</div>
				<a class="brand-link" href={`/${lang}/`} aria-label={`${productName} ${labels.home}`}>
					<span class="brand-badge">RL</span>
					<span class="brand-text">{productName}</span>
				</a>
				<div class="header-actions">
					<LangSwitcher currentLang={lang} currentPath={currentPath} label={labels.switchLanguage} />
					<ThemeToggle
						label={labels.changeTheme}
						lightLabel={labels.themeLight}
						darkLabel={labels.themeDark}
						systemLabel={labels.themeSystem}
					/>
					<a class="login-link" href={`/${lang}/login`}>{labels.login}</a>
				</div>
			</header>
			<main>
				<slot />
			</main>
		</div>
		<script is:inline>
			(() => {
				const initSidebarNavigation = () => {
					const html = document.documentElement;
					const panel = document.querySelector('[data-sidebar-panel]');
					const overlay = document.querySelector('[data-sidebar-overlay]');
					const trigger = document.querySelector('[data-sidebar-trigger]');
					const closeButton = document.querySelector('[data-sidebar-close]');
					const links = document.querySelectorAll('[data-sidebar-link]');

					if (!(panel instanceof HTMLElement) || !(overlay instanceof HTMLElement) || !(trigger instanceof HTMLButtonElement)) {
						return;
					}

					const setOpen = (open) => {
						html.toggleAttribute('data-sidebar-open', open);
						panel.setAttribute('aria-hidden', String(!open));
						overlay.hidden = !open;
						trigger.setAttribute('aria-expanded', String(open));
					};

					trigger.addEventListener('click', () => {
						const nextOpen = !html.hasAttribute('data-sidebar-open');
						setOpen(nextOpen);
					});

					if (closeButton instanceof HTMLButtonElement) {
						closeButton.addEventListener('click', () => setOpen(false));
					}

					overlay.addEventListener('click', () => setOpen(false));

					links.forEach((link) => {
						link.addEventListener('click', () => setOpen(false));
					});

					window.addEventListener('keydown', (event) => {
						if (event.key === 'Escape') {
							setOpen(false);
						}
					});
				};

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', initSidebarNavigation, { once: true });
				} else {
					initSidebarNavigation();
				}
			})();
		</script>
	</body>
</html>
