---
interface Props {
	title?: string;
	description?: string;
	productName?: string;
}

const {
	title = 'Raid Ledger',
	description = 'Lightweight event forms and payout tracking for guild leaders.',
	productName = 'Raid Ledger',
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<div class="page-shell">
			<header class="site-header">
				<div class="header-side"></div>
				<a class="brand-link" href="/" aria-label={`${productName} home`}>
					<span class="brand-badge">RL</span>
					<span>{productName}</span>
				</a>
				<div class="header-actions">
					<button class="language-switch" type="button" aria-label="Switch language">
						<span>中文</span>
						<span class="divider">/</span>
						<span>EN</span>
					</button>
					<a class="login-link" href="/login">登入</a>
				</div>
			</header>
			<main>
				<slot />
			</main>
		</div>
	</body>
</html>

<style>
	:root {
		--bg-top: #eef4ff;
		--bg-bottom: #f9fbff;
		--surface: rgba(255, 255, 255, 0.88);
		--surface-strong: #ffffff;
		--surface-soft: #f5f8ff;
		--line: rgba(80, 115, 185, 0.16);
		--line-strong: rgba(67, 104, 175, 0.28);
		--text-main: #1e2b45;
		--text-soft: #5d6c88;
		--accent: #4a7cff;
		--accent-soft: #dfeaff;
		--accent-deep: #2853c7;
		--success: #2c8f73;
		--shadow: 0 18px 48px rgba(43, 73, 132, 0.08);
		--radius-lg: 28px;
		--radius-md: 18px;
		--radius-sm: 12px;
		--content-width: 1120px;
		font-family:
			'SF Pro Display', 'Segoe UI', 'Noto Sans TC', 'PingFang TC', 'Microsoft JhengHei',
			sans-serif;
		color: var(--text-main);
		background:
			radial-gradient(circle at top left, rgba(118, 166, 255, 0.24), transparent 28%),
			linear-gradient(180deg, var(--bg-top) 0%, var(--bg-bottom) 55%, #ffffff 100%);
	}

	html,
	body {
		margin: 0;
		min-width: 320px;
		min-height: 100%;
	}

	body {
		color: var(--text-main);
		background: transparent;
	}

	* {
		box-sizing: border-box;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	button,
	a {
		-webkit-tap-highlight-color: transparent;
	}

	.page-shell {
		min-height: 100vh;
		padding: 24px;
	}

	.site-header {
		width: min(var(--content-width), 100%);
		margin: 0 auto;
		padding: 16px 20px;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		background: var(--surface);
		backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.75);
		border-radius: 999px;
		box-shadow: var(--shadow);
		position: sticky;
		top: 20px;
		z-index: 10;
	}

	.header-actions {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 12px;
	}

	.brand-link {
		display: inline-flex;
		align-items: center;
		justify-self: center;
		gap: 12px;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	.brand-badge {
		width: 36px;
		height: 36px;
		border-radius: 12px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, var(--accent) 0%, #7ea6ff 100%);
		color: #ffffff;
		font-size: 0.88rem;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28);
	}

	.language-switch,
	.login-link {
		height: 42px;
		padding: 0 16px;
		border-radius: 999px;
		font: inherit;
		font-size: 0.94rem;
		font-weight: 600;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition:
			transform 0.18s ease,
			background 0.18s ease,
			border-color 0.18s ease;
	}

	.language-switch {
		border: 1px solid var(--line);
		background: rgba(255, 255, 255, 0.78);
		color: var(--text-soft);
		gap: 8px;
		cursor: pointer;
	}

	.login-link {
		border: 1px solid transparent;
		background: var(--text-main);
		color: #ffffff;
	}

	.language-switch:hover,
	.login-link:hover {
		transform: translateY(-1px);
	}

	.language-switch:hover {
		border-color: var(--line-strong);
	}

	.login-link:hover {
		background: #162238;
	}

	.divider {
		color: #a0acc3;
	}

	main {
		width: min(var(--content-width), 100%);
		margin: 0 auto;
	}

	@media (max-width: 720px) {
		.page-shell {
			padding: 16px;
		}

		.site-header {
			grid-template-columns: 1fr;
			gap: 14px;
			border-radius: 24px;
			padding: 18px;
			position: static;
		}

		.header-side {
			display: none;
		}

		.brand-link,
		.header-actions {
			justify-self: stretch;
			justify-content: center;
		}

		.header-actions {
			flex-wrap: wrap;
		}
	}
</style>
