---
import SidebarNav from '../components/SidebarNav.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';
import '../styles/theme.css';
import '../styles/components.css';
import type { LangKey } from '../libs/i18n/context/langKeys';

interface Props {
	title?: string;
	description?: string;
	productName?: string;
	lang?: LangKey;
	currentPath?: string;
	labels?: {
		switchLanguage: string;
		changeTheme: string;
		login: string;
		register: string;
		logout: string;
		profile: string;
		loading: string;
		home: string;
		openNavigation: string;
		closeNavigation: string;
		navigation: string;
		navOverview: string;
		navMy: string;
		navOrgs: string;
		officialDashboard: string;
		userStatus: string;
		guest: string;
		themeLight: string;
		themeDark: string;
		themeSystem: string;
	};
}

const {
	title = 'Raid Ledger',
	description = 'Lightweight event forms and payout tracking for guild leaders.',
	productName = 'Raid Ledger',
	lang = 'zh-tw',
	currentPath = '/zh-tw/',
	labels = {
		switchLanguage: 'Switch language',
		changeTheme: 'Change color theme',
		login: 'Login',
		register: 'Register',
		logout: 'Logout',
		profile: 'Profile',
		loading: 'Loading',
		home: 'Home',
		openNavigation: 'Open navigation',
		closeNavigation: 'Close navigation',
		navigation: 'Navigation',
		navOverview: 'Overview',
		navMy: 'My pages',
		navOrgs: 'Organizations',
		officialDashboard: 'Official dashboard',
		userStatus: 'User status',
		guest: 'Guest',
		themeLight: 'Light',
		themeDark: 'Dark',
		themeSystem: 'System',
	},
} = Astro.props;

const navItems = [
	{ label: labels.navOverview, href: `/${lang}/` },
	{ label: labels.navMy, href: `/${lang}/me` },
	{ label: labels.navOrgs, href: `/${lang}/orgs` },
];
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<slot name="head" />
		<script is:inline>
			(() => {
				const stored = window.localStorage.getItem('theme-mode');
				const themeMode =
					stored === 'light' || stored === 'dark' || stored === 'system' ? stored : 'system';
				const resolvedTheme =
					themeMode === 'system'
						? window.matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light'
						: themeMode;

				document.documentElement.dataset.themeMode = themeMode;
				document.documentElement.dataset.theme = resolvedTheme;
			})();
		</script>
	</head>
	<body>
		<div class="page-shell">
			<SidebarNav
				title={labels.navigation}
				items={navItems}
				closeLabel={labels.closeNavigation}
				officialLabel={labels.officialDashboard}
				officialHref={`/${lang}/official`}
				statusLabel={labels.userStatus}
				statusValue={labels.guest}
				statusHref={`/${lang}/login`}
			/>
			<header class="site-header">
				<div class="header-side">
					<button
						class="menu-toggle"
						type="button"
						aria-label={labels.openNavigation}
						aria-expanded="false"
						aria-controls="app-sidebar"
						data-sidebar-trigger
					>
						<span></span>
						<span></span>
						<span></span>
					</button>
				</div>
				<a class="brand-link" href={`/${lang}/`} aria-label={`${productName} ${labels.home}`}>
					<span class="brand-badge">RL</span>
					<span class="brand-text">{productName}</span>
				</a>
				<div class="header-actions">
					<LangSwitcher currentLang={lang} currentPath={currentPath} label={labels.switchLanguage} />
					<ThemeToggle
						label={labels.changeTheme}
						lightLabel={labels.themeLight}
						darkLabel={labels.themeDark}
						systemLabel={labels.themeSystem}
					/>
					<div
						class="auth-controls"
						data-auth-shell
						data-login-href={`/${lang}/login`}
						data-profile-href={`/${lang}/me`}
						data-logout-href={`/${lang}/logout`}
						data-official-href={`/${lang}/official`}
						data-guest-label={labels.guest}
						data-loading-label={labels.loading}
					>
						<a class="login-link" href={`/${lang}/login`} data-auth-login-link>{labels.login}</a>
						<div class="user-menu" hidden data-auth-menu-shell>
							<button
								class="user-menu-trigger"
								type="button"
								aria-expanded="false"
								aria-haspopup="menu"
								aria-label={labels.profile}
								data-auth-menu-trigger
							>
								<span class="user-menu-name" data-auth-user-name>{labels.loading}</span>
							</button>
							<div class="user-menu-dropdown" role="menu" hidden data-auth-menu>
								<a class="user-menu-link" href={`/${lang}/me`} role="menuitem" data-auth-profile-link>
									{labels.profile}
								</a>
								<a class="user-menu-link" href={`/${lang}/logout`} role="menuitem" data-auth-logout-link>
									{labels.logout}
								</a>
							</div>
						</div>
					</div>
				</div>
			</header>
			<main>
				<slot />
			</main>
		</div>
		<script is:inline>
			(() => {
				const initSidebarNavigation = () => {
					const html = document.documentElement;
					const panel = document.querySelector('[data-sidebar-panel]');
					const overlay = document.querySelector('[data-sidebar-overlay]');
					const trigger = document.querySelector('[data-sidebar-trigger]');
					const closeButton = document.querySelector('[data-sidebar-close]');
					const links = document.querySelectorAll('[data-sidebar-link]');

					if (!(panel instanceof HTMLElement) || !(overlay instanceof HTMLElement) || !(trigger instanceof HTMLButtonElement)) {
						return;
					}

					const setOpen = (open) => {
						html.toggleAttribute('data-sidebar-open', open);
						panel.setAttribute('aria-hidden', String(!open));
						overlay.hidden = !open;
						trigger.setAttribute('aria-expanded', String(open));
					};

					trigger.addEventListener('click', () => {
						const nextOpen = !html.hasAttribute('data-sidebar-open');
						setOpen(nextOpen);
					});

					if (closeButton instanceof HTMLButtonElement) {
						closeButton.addEventListener('click', () => setOpen(false));
					}

					overlay.addEventListener('click', () => setOpen(false));

					links.forEach((link) => {
						link.addEventListener('click', () => setOpen(false));
					});

					window.addEventListener('keydown', (event) => {
						if (event.key === 'Escape') {
							setOpen(false);
						}
					});
				};

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', initSidebarNavigation, { once: true });
				} else {
					initSidebarNavigation();
				}
			})();
		</script>
		<script>
			import {
				ensureAuthSession,
				isAuthenticatedSession,
				subscribeAuthSession,
			} from '../libs/api/auth/session.ts';

			const initAuthChrome = async () => {
				const authShell = document.querySelector('[data-auth-shell]');
				const loginLink = document.querySelector('[data-auth-login-link]');
				const menuShell = document.querySelector('[data-auth-menu-shell]');
				const menuTrigger = document.querySelector('[data-auth-menu-trigger]');
				const menu = document.querySelector('[data-auth-menu]');
				const userName = document.querySelector('[data-auth-user-name]');
				const sidebarStatusValue = document.querySelector('[data-sidebar-status-value]');
				const sidebarStatusLink = document.querySelector('[data-sidebar-status-link]');
				const sidebarStaffLink = document.querySelector('[data-sidebar-staff-link]');

				if (
					!(authShell instanceof HTMLElement) ||
					!(loginLink instanceof HTMLAnchorElement) ||
					!(menuShell instanceof HTMLElement) ||
					!(menuTrigger instanceof HTMLButtonElement) ||
					!(menu instanceof HTMLElement) ||
					!(userName instanceof HTMLElement) ||
					!(sidebarStatusLink instanceof HTMLAnchorElement)
				) {
					return;
				}

				const guestLabel = authShell.dataset.guestLabel || 'Guest';
				const loadingLabel = authShell.dataset.loadingLabel || 'Loading';
				const loginHref = authShell.dataset.loginHref || '/';
				const profileHref = authShell.dataset.profileHref || '/';
				const officialHref = authShell.dataset.officialHref || '/';
				const closeMenu = () => {
					menu.hidden = true;
					menuTrigger.setAttribute('aria-expanded', 'false');
				};

				const render = (session) => {
					const displayName = isAuthenticatedSession(session)
						? session.user.displayName || session.user.email
						: guestLabel;

					userName.textContent = displayName;
					if (sidebarStatusValue instanceof HTMLElement) {
						sidebarStatusValue.textContent = displayName;
					}

					if (isAuthenticatedSession(session)) {
						loginLink.hidden = true;
						loginLink.setAttribute('aria-hidden', 'true');
						menuShell.hidden = false;
						sidebarStatusLink.href = profileHref;
						if (sidebarStaffLink instanceof HTMLAnchorElement) {
							sidebarStaffLink.hidden = !session.user.isStaff;
							sidebarStaffLink.href = officialHref;
						}
					} else {
						loginLink.hidden = false;
						loginLink.removeAttribute('aria-hidden');
						menuShell.hidden = true;
						sidebarStatusLink.href = loginHref;
						if (sidebarStaffLink instanceof HTMLAnchorElement) {
							sidebarStaffLink.hidden = true;
						}
						closeMenu();
					}
				};

				userName.textContent = loadingLabel;
				menuTrigger.addEventListener('click', () => {
					const willOpen = menu.hidden;
					closeMenu();
					menu.hidden = !willOpen;
					menuTrigger.setAttribute('aria-expanded', String(willOpen));
				});

				document.addEventListener('click', (event) => {
					const target = event.target;
					if (!(target instanceof Element) || target.closest('[data-auth-shell]')) {
						return;
					}
					closeMenu();
				});

				window.addEventListener('keydown', (event) => {
					if (event.key === 'Escape') {
						closeMenu();
					}
				});

				subscribeAuthSession(render);
				render(await ensureAuthSession(guestLabel));
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initAuthChrome, { once: true });
			} else {
				initAuthChrome();
			}
		</script>
	</body>
</html>
