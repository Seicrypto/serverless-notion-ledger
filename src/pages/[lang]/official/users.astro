---
import Layout from '../../../layouts/Layout.astro';
import OfficialUserProfileManager from '../../../components/features/official/OfficialUserProfileManager.svelte';
import '../../../styles/app-pages.css';
import { getI18n, getLangFromUrl } from '../../../libs/i18n';
import { buildLayoutLabels } from '../../../libs/i18n/layoutLabels';
export { getStaticPaths } from '../../../libs/static/staticPaths';

const lang = getLangFromUrl(Astro.url);
const t = getI18n(lang);
const initialUser = Astro.url.searchParams.get('user') ?? '';
---

<Layout
	title={`${t.app.official_users_title} | ${t.common.product_name}`}
	description={t.app.official_users_intro}
	productName={t.common.product_name}
	lang={lang}
	currentPath={`${Astro.url.pathname}${Astro.url.search}`}
	labels={buildLayoutLabels(t)}
>
	<Fragment slot="head">
		<meta name="robots" content="noindex, nofollow, noarchive" />
	</Fragment>

	<OfficialUserProfileManager
		client:load
		lang={lang}
		initialUser={initialUser}
		labels={{
			eyebrow: t.app.official_overview_users_label,
			title: t.app.official_users_title,
			intro: t.app.official_users_intro,
			nameLabel: t.app.official_users_name_label,
			emailLabel: t.app.official_users_email_label,
			backLabel: t.app.official_users_back_label,
			loadingLabel: t.app.official_gate_loading_label,
			loginRequiredTitle: t.app.official_gate_login_required_title,
			loginRequiredBody: t.app.official_gate_login_required_body,
			staffOnlyTitle: t.app.official_gate_denied_title,
			staffOnlyBody: t.app.official_gate_denied_body,
			loginLabel: t.app.action_login,
			homeLabel: t.app.action_back_home,
			confirmLabel: t.app.me_profile_confirm_label,
			searchInputLabel: t.app.official_users_search_input_label,
			searchPlaceholderUser: t.app.official_users_search_placeholder_user,
			searchSubmitLabel: t.app.official_users_search_submit_label,
			searchClearLabel: t.app.official_users_search_clear_label,
			searchRequiredError: t.app.official_users_search_required_error,
			searchEmptyTitle: t.app.official_users_search_empty_title,
			searchEmptyBody: t.app.official_users_search_empty_body,
			searchNoResultTitle: t.app.official_users_search_no_result_title,
			searchNoResultBody: t.app.official_users_search_no_result_body,
			searchErrorTitle: t.app.official_users_error_title,
			searchErrorBody: t.app.official_users_error_body,
			resultEyebrow: t.app.official_users_result_eyebrow,
			idLabel: t.app.official_users_id_label,
			vanityLabel: t.app.official_users_vanity_label,
			statusLabel: t.app.official_users_status_label,
			emailVerifiedLabel: t.app.official_users_email_verified_label,
			unsetLabel: t.app.official_users_unset_label,
			editVanityLabel: t.app.official_users_edit_vanity_label,
			editDialogTitle: t.app.official_users_edit_vanity_dialog_title,
			editDialogBody: t.app.official_users_edit_vanity_dialog_body,
			editInputLabel: t.app.official_users_edit_vanity_input_label,
			editSubmitLabel: t.app.official_users_edit_vanity_submit_label,
			editCancelLabel: t.app.official_users_edit_vanity_cancel_label,
			editPlaceholder: t.app.official_users_edit_vanity_placeholder,
			editRequiredError: t.app.official_users_edit_vanity_required_error,
			editLengthError: t.app.official_users_edit_vanity_length_error,
			editPatternError: t.app.official_users_edit_vanity_pattern_error,
			actionPendingTitle: t.app.official_users_pending_title,
			actionPendingBody: t.app.official_users_pending_body,
			actionSuccessTitle: t.app.official_users_success_title,
			actionSuccessBody: t.app.official_users_success_body,
			actionErrorTitle: t.app.official_users_error_title,
			actionErrorBody: t.app.official_users_error_body,
			statusApproveLabel: t.app.official_users_approve_label,
			statusEnableLabel: t.app.official_users_enable_label,
			statusDisableLabel: t.app.official_users_disable_label,
			deleteConfirmLabel: t.app.official_users_delete_confirm_label,
			deleteDangerLabel: t.app.official_users_delete_label,
			deleteSuccessBody: t.app.official_users_delete_success_body,
			deleteAdminOnlyBody: t.app.official_users_delete_admin_only_body,
		}}
	/>
</Layout>
