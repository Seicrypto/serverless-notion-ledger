---
import Layout from '../../../layouts/Layout.astro';
import MyPayoutsOverview from '../../../components/features/me/MyPayoutsOverview.svelte';
import '../../../styles/app-pages.css';
import { getI18n, getLangFromUrl } from '../../../libs/i18n';
import { buildLayoutLabels } from '../../../libs/i18n/layoutLabels';
export { getStaticPaths } from '../../../libs/static/staticPaths';

const lang = getLangFromUrl(Astro.url);
const t = getI18n(lang);
---

<Layout
	title={`${t.app.me_payouts_title} | ${t.common.product_name}`}
	description={t.app.me_payouts_intro}
	productName={t.common.product_name}
	lang={lang}
	currentPath={`${Astro.url.pathname}${Astro.url.search}`}
	labels={buildLayoutLabels(t)}
>
	<MyPayoutsOverview
		client:load
		lang={lang}
		labels={{
			eyebrow: t.common.nav_my,
			title: t.app.me_payouts_title,
			intro: t.app.me_payouts_intro,
			loadingLabel: t.app.auth_required_loading_label,
			authRequiredTitle: t.app.auth_required_title,
			authRequiredBody: t.app.auth_required_body,
			loginLabel: t.app.action_login,
			homeLabel: t.app.action_back_home,
		}}
	/>
</Layout>
