---
import Layout from '../../../layouts/Layout.astro';
import MyOrganizationsOverview from '../../../components/features/org/MyOrganizationsOverview.svelte';
import '../../../styles/app-pages.css';
import { getI18n, getLangFromUrl } from '../../../libs/i18n';
import { buildLayoutLabels } from '../../../libs/i18n/layoutLabels';
export { getStaticPaths } from '../../../libs/static/staticPaths';

const lang = getLangFromUrl(Astro.url);
const t = getI18n(lang);
---

<Layout
	title={`${t.app.me_orgs_title} | ${t.common.product_name}`}
	description={t.app.me_orgs_intro}
	productName={t.common.product_name}
	lang={lang}
	currentPath={`${Astro.url.pathname}${Astro.url.search}`}
	labels={buildLayoutLabels(t)}
>
	<MyOrganizationsOverview
		client:load
		lang={lang}
		labels={{
			title: t.app.me_orgs_title,
			intro: t.app.me_orgs_intro,
			loadingLabel: t.app.me_orgs_loading_label,
			errorTitle: t.app.me_orgs_error_title,
			emptyTitle: t.app.me_orgs_empty_title,
			emptyBody: t.app.me_orgs_empty_body,
			viewOrgsLabel: t.app.action_search_orgs,
			createOrgLabel: t.app.action_create_org,
			openOrgManageLabel: t.app.action_open_org_manage,
			openOrgDashboardLabel: t.app.action_open_org_dashboard,
			memberCountLabel: t.app.orgs_member_count_label,
			characterCountLabel: t.app.orgs_character_count_label,
			supportedOrgLabel: t.app.orgs_supported_org_label,
			authRequiredTitle: t.app.auth_required_title,
			authRequiredBody: t.app.auth_required_body,
			loginLabel: t.app.action_login,
			homeLabel: t.app.action_back_home,
		}}
	/>
</Layout>
