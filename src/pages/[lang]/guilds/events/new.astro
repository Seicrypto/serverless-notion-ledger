---
import Layout from '../../../../layouts/Layout.astro';
import EventCreationWorkspace from '../../../../components/features/events/EventCreationWorkspace.svelte';
import '../../../../styles/app-pages.css';
import { getI18n, getLangFromUrl } from '../../../../libs/i18n';
import { buildLayoutLabels } from '../../../../libs/i18n/layoutLabels';
export { getStaticPaths } from '../../../../libs/static/staticPaths';

const lang = getLangFromUrl(Astro.url);
const t = getI18n(lang);
const orgVanity = Astro.url.searchParams.get('orgVanity') ?? Astro.url.searchParams.get('org');
const quickCreateId = Astro.url.searchParams.get('quickCreateId');
---

<Layout
	title={`${t.app.events_title} | ${t.common.product_name}`}
	description={t.app.events_intro}
	productName={t.common.product_name}
	lang={lang}
	currentPath={`${Astro.url.pathname}${Astro.url.search}`}
	labels={buildLayoutLabels(t)}
>
	<EventCreationWorkspace
		client:load
		lang={lang}
		organization={orgVanity}
		quickCreateId={quickCreateId}
		labels={{
			eyebrow: t.common.nav_events,
			title: t.app.events_title,
			intro: t.app.events_intro,
			authRequiredTitle: t.app.events_auth_required_title,
			authRequiredBody: t.app.events_auth_required_body,
			loginLabel: t.common.login,
			homeLabel: t.common.nav_home,
			sessionTitle: t.app.events_session_title,
			sessionBody: t.app.events_session_body,
			sessionCountLabel: t.app.events_session_count_label,
			quickCreateLabel: t.app.events_quick_create_label,
			quickCreateEmpty: t.app.events_quick_create_empty,
			quickCreateTitle: t.app.events_quick_create_title,
			quickCreateBody: t.app.events_quick_create_body,
			quickCreateSelectLabel: t.app.events_quick_create_select_label,
			quickCreateConfirmLabel: t.app.events_quick_create_confirm_label,
			quickCreateCancelLabel: t.app.events_quick_create_cancel_label,
			quickCreateCloseLabel: t.app.events_quick_create_close_label,
			quickCreateDefaultPrefix: t.app.events_quick_create_default_prefix,
			yesterdayPrefix: t.app.events_yesterday_prefix,
			orgRequiredTitle: t.app.events_org_required_title,
			orgRequiredBody: t.app.events_org_required_body,
			contextTitle: t.app.events_context_title,
			contextBodyPrefix: t.app.events_context_body_prefix,
			contextSelectLabel: t.app.events_context_select_label,
			contextSelectPlaceholder: t.app.events_context_select_placeholder,
			contextSelectEmpty: t.app.events_context_select_empty,
			titleLabel: t.app.events_form_title_label,
			titlePlaceholder: t.app.events_form_title_placeholder,
			occurredAtLabel: t.app.events_form_occurred_at_label,
			eventTypeLabel: t.app.events_form_event_type_label,
			sourceTypeLabel: t.app.events_form_source_type_label,
			sourceTypeLockedHint: t.app.events_form_source_type_locked_hint,
			gameIdLabel: t.app.events_form_game_id_label,
			gameRequiredHint: t.app.events_form_game_required_hint,
			holderTypeLabel: t.app.events_form_holder_type_label,
			holderRefLabel: t.app.events_form_holder_ref_label,
			holderRefPlaceholder: t.app.events_form_holder_ref_placeholder,
			holderRefEmpty: t.app.events_form_holder_ref_empty,
			holderRefHint: t.app.events_form_holder_ref_hint,
			holderRefManualHint: t.app.events_form_holder_ref_manual_hint,
			holderRefUnclaimedMeta: t.app.events_form_holder_ref_unclaimed_meta,
			holderRefSelectedLabel: t.app.events_form_holder_ref_selected_label,
			holderRefAddLabel: t.app.events_form_holder_ref_add_label,
			holderRefChangeLabel: t.app.events_form_holder_ref_change_label,
			participantsLabel: t.app.events_form_participants_label,
			participantsPlaceholder: t.app.events_form_participants_placeholder,
			participantsEmpty: t.app.events_form_participants_empty,
			participantsHint: t.app.events_form_participants_hint,
			participantsSelectedLabel: t.app.events_form_participants_selected_label,
			participantsAddLabel: t.app.events_form_participants_add_label,
			notesLabel: t.app.events_form_notes_label,
			notesPlaceholder: t.app.events_form_notes_placeholder,
			assetSectionLabel: t.app.events_assets_section_label,
			assetSectionBody: t.app.events_assets_section_body,
			assetSectionAdvancedBody: t.app.events_assets_section_advanced_body,
			assetCatalogHint: t.app.events_assets_catalog_hint,
			assetQuickPickLabel: t.app.events_assets_quick_pick_label,
			assetQuickPickPlaceholder: t.app.events_assets_quick_pick_placeholder,
			assetQuickPickEmpty: t.app.events_assets_quick_pick_empty,
			assetSelectedLabel: t.app.events_assets_selected_label,
			assetSingleHint: t.app.events_assets_single_hint,
			clearSelectionLabel: t.app.events_clear_selection_label,
			addAssetLabel: t.app.events_assets_add_label,
			removeAssetLabel: t.app.events_assets_remove_label,
			advancedModeLabel: t.app.events_assets_advanced_mode_label,
			basicModeLabel: t.app.events_assets_basic_mode_label,
			advancedModeHint: t.app.events_assets_advanced_mode_hint,
			assetSearchLabel: t.app.events_assets_search_label,
			assetSearchingLabel: t.app.events_assets_searching_label,
			assetDetailLabel: t.app.events_assets_detail_label,
			assetDetailComingSoonTitle: t.app.events_assets_detail_coming_soon_title,
			assetDetailComingSoonBody: t.app.events_assets_detail_coming_soon_body,
			createItemLabel: t.app.events_assets_create_item_label,
			createItemTitle: t.app.events_assets_create_item_title,
			createItemNameLabel: t.app.events_assets_create_item_name_label,
			createItemNamePlaceholder: t.app.events_assets_create_item_name_placeholder,
			createItemCreateLabel: t.app.events_assets_create_item_create_label,
			createItemCancelLabel: t.app.events_assets_create_item_cancel_label,
			createItemKnownDuplicateTitle: t.app.events_assets_duplicate_title,
			createItemKnownDuplicateBody: t.app.events_assets_duplicate_body,
			createItemResolveReviewBody: t.app.events_assets_resolve_review_body,
			createItemCreateAnywayLabel: t.app.events_assets_create_anyway_label,
			useExistingItemLabel: t.app.events_assets_use_existing_label,
			submitLabel: t.app.events_form_submit_label,
			requiredHint: t.app.events_required_hint,
			optionalHint: t.app.events_optional_hint,
			validationRequired: t.app.events_validation_required,
			validationDate: t.app.events_validation_date,
			validationNumber: t.app.events_validation_number,
			validationContext: t.app.events_validation_context,
			validationHolderCharacter: t.app.events_validation_holder_character,
			loadingGames: t.app.events_loading_games,
			eventTypeLoot: t.app.events_event_type_loot,
			eventTypeRaid: t.app.events_event_type_raid,
			eventTypeActivity: t.app.events_event_type_activity,
			eventTypeBonus: t.app.events_event_type_bonus,
			eventTypeSalary: t.app.events_event_type_salary,
			eventTypeGuildEvent: t.app.events_event_type_guild_event,
			eventTypeOther: t.app.events_event_type_other,
			sourceTypeManual: t.app.events_source_type_manual,
			sourceTypeApi: t.app.events_source_type_api,
			sourceTypeImport: t.app.events_source_type_import,
			holderTypeCharacter: t.app.events_holder_type_character,
			holderTypeOrgTreasury: t.app.events_holder_type_org_treasury,
			holderTypeMarket: t.app.events_holder_type_market,
			holderTypeExternal: t.app.events_holder_type_external,
			holderTypeCustom: t.app.events_holder_type_custom,
			loadingCreateTitle: t.app.events_loading_create_title,
			loadingCreateSingleBody: t.app.events_loading_create_single_body,
			loadingCreateBatchPrefix: t.app.events_loading_create_batch_prefix,
			errorCreateTitle: t.app.events_error_create_title,
			errorTimeoutBody: t.app.events_error_timeout_body,
			errorRetryLabel: t.app.events_error_retry_label,
			errorPartialPrefix: t.app.events_error_partial_prefix,
			successCreateTitle: t.app.events_success_create_title,
			successCreateSingleBody: t.app.events_success_create_single_body,
			successCreateBatchPrefix: t.app.events_success_create_batch_prefix,
			successCreateSuffix: t.app.events_success_create_suffix,
			successCloseLabel: t.app.events_success_close_label,
		}}
	/>
</Layout>
