---
import Layout from '../../../layouts/Layout.astro';
import OrganizationDirectory from '../../../components/features/org/OrganizationDirectory.svelte';
import '../../../styles/app-pages.css';
import { getI18n, getLangFromUrl } from '../../../libs/i18n';
import { buildLayoutLabels } from '../../../libs/i18n/layoutLabels';
export { getStaticPaths } from '../../../libs/static/staticPaths';

const lang = getLangFromUrl(Astro.url);
const t = getI18n(lang);
const initialQuery = Astro.url.searchParams.get('q') ?? '';
const initialGameSlug = Astro.url.searchParams.get('game') ?? 'spiritvale';
const initialOffset = Number(Astro.url.searchParams.get('offset') ?? '0');
---

<Layout
	title={`${t.app.orgs_title} | ${t.common.product_name}`}
	description={t.app.orgs_intro}
	productName={t.common.product_name}
	lang={lang}
	currentPath={`${Astro.url.pathname}${Astro.url.search}`}
	labels={buildLayoutLabels(t)}
>
	<section class="directory-hero">
		<div class="directory-hero-copy">
			<p class="app-eyebrow">{t.app.orgs_search_eyebrow}</p>
			<h1>{t.app.orgs_search_title}</h1>
			<p class="directory-hero-intro">{t.app.orgs_search_intro}</p>
			<div class="app-actions">
				<a class="app-action-primary" href={`/${lang}/me/guilds`}>
					{t.app.action_view_my_orgs}
				</a>
				<a class="app-action-secondary" href={`/${lang}/`}>
					{t.app.action_back_home}
				</a>
			</div>
		</div>

		<div class="directory-hero-side">
			<a class="directory-create-button" href={`/${lang}/guilds/new`}>
				{t.app.action_create_org}
			</a>
		</div>
	</section>

	<section class="app-section">
		<OrganizationDirectory
			client:load
			lang={lang}
			labels={{
				searchLabel: t.app.orgs_search_label,
				searchPlaceholder: t.app.orgs_search_placeholder,
				gameLabel: t.app.orgs_game_label,
				submitLabel: t.app.orgs_submit_label,
				clearLabel: t.app.orgs_clear_label,
				loadingLabel: t.app.orgs_loading_label,
				emptyTitle: t.app.orgs_empty_title,
				emptyBody: t.app.orgs_empty_body,
				errorTitle: t.app.orgs_error_title,
				prevLabel: t.app.orgs_prev_label,
				nextLabel: t.app.orgs_next_label,
				pageLabel: t.app.orgs_page_label,
				resultCountLabel: t.app.orgs_result_count_label,
				memberCountLabel: t.app.orgs_member_count_label,
				characterCountLabel: t.app.orgs_character_count_label,
				supportedOrgLabel: t.app.orgs_supported_org_label,
				openOrgLabel: t.app.orgs_view_info_label,
				applyOrgLabel: t.app.action_apply_org,
				applyingOrgLabel: t.app.action_apply_org_pending,
				appliedOrgLabel: t.app.action_applied_org,
				applyOrgErrorTitle: t.app.orgs_apply_error_title,
				loginLabel: t.app.action_login,
				applyOrgDialogTitle: t.app.orgs_apply_dialog_title,
				applyOrgDialogIntro: t.app.orgs_apply_dialog_intro,
				applyOrgDialogChooseTabLabel: t.app.orgs_apply_dialog_choose_tab,
				applyOrgDialogCreateTabLabel: t.app.orgs_apply_dialog_create_tab,
				applyOrgDialogCancelLabel: t.app.orgs_apply_dialog_cancel,
				applyOrgDialogSubmitLabel: t.app.orgs_apply_dialog_submit,
				applyOrgDialogLoadingLabel: t.app.orgs_apply_dialog_loading,
				applyOrgDialogRoleFieldLabel: t.app.orgs_apply_dialog_role_field_label,
				applyOrgDialogRolePlaceholder: t.app.orgs_apply_dialog_role_placeholder,
				applyOrgDialogRoleEmptyLabel: t.app.orgs_apply_dialog_role_empty_label,
				applyOrgDialogRoleHint: t.app.orgs_apply_dialog_role_hint,
				applyOrgDialogRoleRequiredError: t.app.orgs_apply_dialog_role_required_error,
				applyOrgDialogNewRoleFieldLabel: t.app.orgs_apply_dialog_new_role_field_label,
				applyOrgDialogNewRolePlaceholder: t.app.orgs_apply_dialog_new_role_placeholder,
				applyOrgDialogNewRoleHint: t.app.orgs_apply_dialog_new_role_hint,
				applyOrgDialogNewRoleRequiredError: t.app.orgs_apply_dialog_new_role_required_error,
				applyOrgDialogNoRolesBody: t.app.orgs_apply_dialog_no_roles_body,
				applyOrgDialogGameHintPrefix: t.app.orgs_apply_dialog_game_hint_prefix,
				applyOrgDialogMissingGameBody: t.app.orgs_apply_dialog_missing_game_body,
			}}
			gameOptions={[{ label: 'SpiritVale', value: 'spiritvale' }]}
			initialQuery={initialQuery}
			initialGameSlug={initialGameSlug}
			initialOffset={Number.isFinite(initialOffset) ? Math.max(initialOffset, 0) : 0}
			pageSize={10}
		/>
	</section>
</Layout>
