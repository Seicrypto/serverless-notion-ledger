---
import Layout from '../../layouts/Layout.astro';
import AppPage from '../../components/page/AppPage.astro';
import '../../styles/app-pages.css';
import { getI18n, getLangFromUrl } from '../../libs/i18n';
import { buildLayoutLabels } from '../../libs/i18n/layoutLabels';
export { getStaticPaths } from '../../libs/static/staticPaths';

const lang = getLangFromUrl(Astro.url);
const t = getI18n(lang);
---

<Layout
	title={`${t.app.official_title} | ${t.common.product_name}`}
	description={t.app.official_intro}
	productName={t.common.product_name}
	lang={lang}
	currentPath={`${Astro.url.pathname}${Astro.url.search}`}
	labels={buildLayoutLabels(t)}
>
	<Fragment slot="head">
		<meta name="robots" content="noindex, nofollow, noarchive" />
	</Fragment>

	<div
		data-official-page
		data-login-href={`/${lang}/login`}
		data-home-href={`/${lang}/`}
		data-denied-label={t.app.official_guard_denied}
	>
		<AppPage
			eyebrow={t.common.official_dashboard}
			title={t.app.official_title}
			intro={t.app.official_intro}
			statusLabel={t.common.user_status}
			statusValue={t.app.official_guard_pending}
			primaryLink={{ label: t.app.action_view_me, href: `/${lang}/me` }}
			secondaryLink={{ label: t.app.action_back_home, href: `/${lang}/` }}
			cards={[
				{ label: t.app.card_scope_label, title: t.app.card_scope_title, body: t.app.card_scope_body },
				{ label: t.app.card_data_label, title: t.app.card_data_title, body: t.app.card_data_body },
				{ label: t.app.card_next_label, title: t.app.card_next_title, body: t.app.card_next_body },
			]}
		/>
		<p class="app-intro" data-official-status>{t.app.official_guard_pending}</p>
	</div>

	<script>
		import { ensureAuthSession, isAuthenticatedSession } from '../../libs/api/auth/session.ts';

		const initOfficialGuard = async () => {
			const page = document.querySelector('[data-official-page]');
			const status = document.querySelector('[data-official-status]');
			if (!(page instanceof HTMLElement)) {
				return;
			}

			const loginHref = page.dataset.loginHref || '/';
			const homeHref = page.dataset.homeHref || '/';
			const session = await ensureAuthSession();

			if (isAuthenticatedSession(session) && session.user.isStaff) {
				if (status instanceof HTMLElement) {
					status.textContent = session.user.displayName || session.user.email;
				}
				return;
			}

			if (status instanceof HTMLElement) {
				status.textContent = page.dataset.deniedLabel || 'Staff permission required. Redirecting now.';
			}

			window.setTimeout(() => {
				window.location.href = isAuthenticatedSession(session) ? homeHref : loginHref;
			}, 300);
		};

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initOfficialGuard, { once: true });
		} else {
			initOfficialGuard();
		}
	</script>
</Layout>
