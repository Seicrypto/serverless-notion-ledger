---
import Layout from '../../layouts/Layout.astro';
import '../../styles/auth.css';
import { getI18n, getLangFromUrl } from '../../libs/i18n';
import { buildLayoutLabels } from '../../libs/i18n/layoutLabels';
export { getStaticPaths } from '../../libs/static/staticPaths';

const lang = getLangFromUrl(Astro.url);
const t = getI18n(lang);
---

<Layout
	title={`${t.app.account_status_title} | ${t.common.product_name}`}
	description={t.app.account_status_intro}
	productName={t.common.product_name}
	lang={lang}
	currentPath={`${Astro.url.pathname}${Astro.url.search}`}
	labels={buildLayoutLabels(t)}
>
	<section
		class="auth-shell"
		data-account-status-page
		data-default-state={t.app.account_status_unknown_title}
		data-default-message={t.app.account_status_unknown_body}
		data-email-verification-title={t.app.account_status_verify_title}
		data-email-verification-message={t.app.account_status_verify_body}
		data-pending-approval-title={t.app.account_status_pending_title}
		data-pending-approval-message={t.app.account_status_pending_body}
		data-disabled-title={t.app.account_status_disabled_title}
		data-disabled-message={t.app.account_status_disabled_body}
		data-active-title={t.app.account_status_active_title}
		data-active-message={t.app.account_status_active_body}
		data-reset-title={t.app.account_status_reset_title}
		data-reset-message={t.app.account_status_reset_body}
		data-email-label={t.app.auth_email_label}
		data-code-label={t.app.auth_code_label}
		data-password-label={t.app.auth_new_password_label}
		data-verify-label={t.app.auth_submit_verify}
		data-reset-label={t.app.auth_submit_reset_password}
		data-resend-label={t.app.auth_submit_resend_verification}
		data-back-login-label={t.app.action_login}
		data-back-home-label={t.app.action_back_home}
		data-pending-message={t.app.auth_pending}
		data-error-message={t.app.auth_error_fallback}
		data-verify-success-message={t.app.auth_verify_success}
		data-resend-success-message={t.app.auth_resend_success}
		data-reset-success-message={t.app.auth_reset_success}
		data-login-url={`/${lang}/login`}
		data-home-url={`/${lang}/`}
		data-status-url={`/${lang}/account-status`}
		data-profile-url={`/${lang}/me`}
	>
		<article class="auth-panel">
			<p class="auth-kicker">{t.app.account_status_kicker}</p>
			<h1 data-account-status-title>{t.app.account_status_title}</h1>
			<p class="auth-intro" data-account-status-message>{t.app.account_status_intro}</p>

			<form class="auth-form" data-account-status-form hidden>
				<label class="auth-field">
					<span class="auth-field-label" data-key-label>{t.app.auth_email_label}</span>
					<input class="auth-input" type="text" name="key" autocomplete="email" data-key-input />
				</label>
				<label class="auth-field">
					<span class="auth-field-label">{t.app.auth_code_label}</span>
					<input class="auth-input" type="text" name="token" autocomplete="one-time-code" required />
				</label>
				<label class="auth-field" data-password-field hidden>
					<span class="auth-field-label">{t.app.auth_new_password_label}</span>
					<input
						class="auth-input"
						type="password"
						name="password"
						autocomplete="new-password"
						minlength="8"
					/>
				</label>
				<div class="auth-actions">
					<button class="auth-submit" type="submit" data-submit-button>
						{t.app.auth_submit_verify}
					</button>
					<button class="auth-secondary-button" type="button" data-resend-button hidden>
						{t.app.auth_submit_resend_verification}
					</button>
				</div>
			</form>

			<div class="auth-status" data-state="idle" data-auth-status>
				<p class="auth-status-label">{t.app.auth_status_label}</p>
				<div class="auth-status-body">
					<span class="auth-status-spinner" aria-hidden="true" data-auth-status-spinner></span>
					<p class="auth-status-text" data-auth-status-text></p>
				</div>
			</div>
		</article>

		<aside class="auth-side-card">
			<p class="auth-side-kicker">{t.app.account_status_help_kicker}</p>
			<h2>{t.app.account_status_help_title}</h2>
			<p data-account-status-side-message>{t.app.account_status_help_body}</p>
			<ul class="auth-side-list">
				<li>{t.app.account_status_help_item_one}</li>
				<li>{t.app.account_status_help_item_two}</li>
				<li>{t.app.account_status_help_item_three}</li>
			</ul>
			<div class="auth-actions">
				<a class="auth-link-button" href={`/${lang}/login`} data-login-link>{t.app.action_login}</a>
				<a class="auth-link-button" href={`/${lang}/`}>{t.app.action_back_home}</a>
			</div>
		</aside>
	</section>

	<script>
		import { initAccountStatusPage } from '../../libs/account-status/init-account-status-page.ts';

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initAccountStatusPage, { once: true });
		} else {
			initAccountStatusPage();
		}
	</script>
</Layout>
