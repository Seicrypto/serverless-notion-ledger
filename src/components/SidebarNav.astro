---
interface NavItem {
	label: string;
	href: string;
}

interface Props {
	title: string;
	items: NavItem[];
	closeLabel: string;
	officialLabel?: string;
	officialHref?: string;
	statusLabel: string;
	statusValue: string;
	statusHref: string;
}

const { title, items, closeLabel, officialLabel, officialHref, statusLabel, statusValue, statusHref } =
	Astro.props;
---

<div class="sidebar-shell" data-sidebar-shell>
	<button class="sidebar-overlay" type="button" aria-label={closeLabel} hidden data-sidebar-overlay></button>
	<aside class="sidebar-panel" aria-hidden="true" data-sidebar-panel>
		<div class="sidebar-header">
			<p class="sidebar-kicker">{title}</p>
			<button class="sidebar-close" type="button" aria-label={closeLabel} data-sidebar-close>
				<span></span>
				<span></span>
			</button>
		</div>

		<nav class="sidebar-nav" aria-label={title}>
			{items.map((item) => (
				<a class="sidebar-link" href={item.href} data-sidebar-link>
					{item.label}
				</a>
			))}
		</nav>

		<div class="sidebar-footer">
			{officialLabel && officialHref && (
				<a class="sidebar-link sidebar-link-staff" href={officialHref} hidden data-sidebar-staff-link>
					{officialLabel}
				</a>
			)}

			<a class="sidebar-status" href={statusHref} data-sidebar-status-link>
				<p class="sidebar-status-label">{statusLabel}</p>
				<p class="sidebar-status-value" data-sidebar-status-value>{statusValue}</p>
			</a>
		</div>
	</aside>
</div>
